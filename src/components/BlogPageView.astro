---
import BaseLayout from '../layouts/BaseLayout.astro';
import TagFilterHeader from './TagFilterHeader.astro';
import BlogCard from './BlogCard.astro';
import { createWithBase, getBlogDerivedText, type BlogListItem } from '../lib/content';
import { getThemeSettings, getVisibleArticleMetaTags } from '../lib/theme-settings';
import { collectTagSummary, type TagSummary } from '../lib/tags';
import { joinPageSubtitleText } from '../utils/format';
import { PAGE_SIZE_BLOG } from '../../site.config.mjs';

const { items, resultCount } = Astro.props as {
  items: BlogListItem[];
  resultCount: number;
};

/** `/blog/` 的标签入口：不传 tagOptions 时 TagFilterHeader 不渲染标签 dialog。 */
const tagOptions: TagSummary[] = collectTagSummary(items.map((item) => item.entry));

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const {
  settings: {
    page,
    ui: { articleMeta, cardDateDisplay }
  }
} = getThemeSettings();
/** 列表页描述行里的 RSS 由后台「内页设置 → RSS 订阅」控制（总开关且本页开关）。 */
const showListRss = page.listRss.enabled !== false && page.listRss.blog !== false;

const pageTitleText = page.blog.title || '博客';
const subtitleText = joinPageSubtitleText(page.blog.subtitle, `共 ${resultCount} 篇`);
const pageDescription = joinPageSubtitleText(
  `${pageTitleText}列表`,
  page.blog.subtitle,
  `共 ${resultCount} 篇`
) ?? `${pageTitleText}列表`;
const fallbackListId = 'blog-tag-list';
---

<BaseLayout title={pageTitleText} description={pageDescription} bodyClass="blog-page">
  <div
    class="entry-filters"
    data-entry-filters
    data-index-url="/blog/index.json"
    data-page-size={String(PAGE_SIZE_BLOG)}
  >
    <TagFilterHeader
      pageTitleText={pageTitleText}
      subtitleText={subtitleText}
      rssHref={withBase('/blog/rss.xml')}
      pickerHref={`#${fallbackListId}`}
      fallbackListId={fallbackListId}
      dialogTitleId="blog-tag-dialog-title"
      searchAriaLabel={`搜索${pageTitleText}`}
      tagOptions={tagOptions}
      showRss={showListRss}
      headerClass="page-header page-header--blog page-header--with-search"
    />
  </div>

  <div class="list" data-entry-list>
    {items.map((item) => (
      <BlogCard
        href={withBase(item.href)}
        slug={item.entry.id}
        title={item.entry.data.title}
        excerpt={getBlogDerivedText(item.entry).excerpt}
        date={item.entry.data.date}
        dateText={item.entry.data.dateText}
        dateHasTime={item.entry.data.dateHasTime}
        publishedAt={item.entry.data.publishedAt}
        publishedAtText={item.entry.data.publishedAtText}
        publishedAtHasTime={item.entry.data.publishedAtHasTime}
        updatedAt={item.entry.data.updatedAt}
        updatedAtText={item.entry.data.updatedAtText}
        updatedAtHasTime={item.entry.data.updatedAtHasTime}
        dateDisplay={item.entry.data.cardDateDisplay ?? cardDateDisplay}
        visibleTags={getVisibleArticleMetaTags(item.entry.data.tags, 'list')}
        articleMetaSettings={articleMeta}
        badge={item.entry.data.badge}
        versionLabel={item.versionLabel}
        versionCount={item.versionCount}
        isLatest={item.isLatest}
      />
    ))}
  </div>

  <nav class="pagination" data-entry-pagination hidden aria-label={`${pageTitleText}分页`}>
    <div class="pagination__inner" data-entry-pagination-inner></div>
  </nav>

  <script>
    import '../scripts/entry-search.ts';
  </script>
</BaseLayout>
