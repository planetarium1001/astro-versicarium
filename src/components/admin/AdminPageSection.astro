---
import AdminIcon from './AdminIcon.astro';
import UiIcon from '../UiIcon.astro';
import {
  ADMIN_ARCHIVE_VERSION_MODE_OPTIONS,
  ADMIN_ARTICLE_DATE_DISPLAY_OPTIONS,
  ADMIN_ARTICLE_DATE_GRANULARITY_OPTIONS,
  ADMIN_ARTICLE_META_DATE_LABEL_MAX_LENGTH,
  ADMIN_PAGINATION_PAGE_OPTIONS,
  ADMIN_PAGINATION_PAGE_SIZE_MAX,
  ADMIN_PAGINATION_PAGE_SIZE_MIN,
  ADMIN_VIEW_STATS_LABEL_MAX_LENGTH
} from '../../lib/admin-console/theme-shared';

interface Props {
  pageTitleMaxLength: number;
  pageSubtitleMaxLength: number;
}

const {
  pageTitleMaxLength,
  pageSubtitleMaxLength
} = Astro.props;

// 内页文案：每个集合一对「主标题 | 副标题」输入框，只有占位文案不同。
const pageTitlePairFields = [
  { slug: 'blog', titlePlaceholder: '随笔', subtitlePlaceholder: '随笔与杂记' },
  { slug: 'projects', titlePlaceholder: '项目', subtitlePlaceholder: '散者归之，各归其地' },
  { slug: 'bits', titlePlaceholder: '动态', subtitlePlaceholder: '生活不只是长篇' },
  { slug: 'devlog', titlePlaceholder: '更新', subtitlePlaceholder: '逐条记录项目的每一次改动' },
  { slug: 'archive', titlePlaceholder: '归档', subtitlePlaceholder: '按年份分组的归档目录' },
  { slug: 'about', titlePlaceholder: '关于', subtitlePlaceholder: null }
];

// 浏览数据：PV / UV 各一行「显示开关 | 前缀输入框」。
const viewStatsInlineFields = [
  { key: 'pv', toggleLabel: '显示浏览量', placeholder: '浏览' },
  { key: 'uv', toggleLabel: '显示访客数', placeholder: '访客' }
];
---

<fieldset class="admin-group">
  <legend class="admin-group__legend">
    <AdminIcon name="admin-page" class="admin-group__legend-icon" size={14} />
    <span class="admin-group__legend-copy">
      <span class="admin-group__legend-zh">内页设置</span>
      <span class="admin-group__legend-en">Inner pages</span>
    </span>
  </legend>
  <div class="admin-grid">
    {pageTitlePairFields.map((field) => (
      <label class="admin-field">
        <span class="admin-label">
          <span class="admin-label__main">
            <code>/{field.slug}/</code> 页面主 <span class="admin-label__pipe" aria-hidden="true">|</span> 副标题
          </span>
        </span>
        <span class="admin-title-pair" role="group" aria-label={`/${field.slug}/ 页面主标题与副标题`}>
          <input
            id={`page-${field.slug}-title`}
            class="admin-title-pair__input admin-title-pair__input--title"
            type="text"
            maxlength={pageTitleMaxLength}
            autocomplete="off"
            placeholder={field.titlePlaceholder}
            aria-label={`/${field.slug}/ 页面主标题`}
          />
          <span class="admin-title-pair__sep" aria-hidden="true">|</span>
          <input
            id={`page-${field.slug}-subtitle`}
            class="admin-title-pair__input admin-title-pair__input--subtitle"
            type="text"
            maxlength={pageSubtitleMaxLength}
            autocomplete="off"
            placeholder={field.subtitlePlaceholder ?? undefined}
            aria-label={`/${field.slug}/ 页面副标题`}
          />
        </span>
      </label>
    ))}
  </div>

  <div class="admin-subgroup">
    <label class="admin-field">
      <span class="admin-label">
        <span class="admin-label__main">归档版本</span>
        <span class="admin-label__hint">（/archive/ 显示全部历史版本或每个系列只显示最新版）</span>
      </span>
      <select class="admin-field__control" id="page-archive-version-mode">
        {ADMIN_ARCHIVE_VERSION_MODE_OPTIONS.map((option) => (
          <option value={option.id}>{option.label}</option>
        ))}
      </select>
    </label>
  </div>

  <div class="admin-subgroup admin-subgroup--article-meta">
    <p class="admin-subtitle">
      <span class="admin-subtitle__main">文章元信息</span>
      <span class="admin-subtitle__hint">（字数/时长仅详情页，移动端隐藏；粒度默认仅日期，frontmatter 可覆盖，无时分回退日期）</span>
    </p>

    <div class="admin-meta-group">
      <p class="admin-meta-group__label">日期</p>
      <div class="admin-toggle-row-group__line">
        <label class="admin-toggle-row admin-toggle-row--compact" for="ui-article-meta-show-date">
          <input id="ui-article-meta-show-date" type="checkbox" />
          <span>显示日期</span>
        </label>
        <span class="admin-toggle-row__sep" aria-hidden="true">|</span>
        <label class="admin-inline-field" for="ui-article-meta-date-label">
          <span class="admin-inline-field__label">前缀：</span>
          <input
            id="ui-article-meta-date-label"
            class="admin-inline-field__input"
            type="text"
            maxlength={ADMIN_ARTICLE_META_DATE_LABEL_MAX_LENGTH}
            autocomplete="off"
            placeholder="发布于："
          />
        </label>
        <span class="admin-toggle-row__sep" aria-hidden="true">|</span>
        <label class="admin-inline-field" for="ui-article-meta-date-display">
          <span class="admin-inline-field__label">显示：</span>
          <select id="ui-article-meta-date-display" class="admin-inline-field__input">
            {ADMIN_ARTICLE_DATE_DISPLAY_OPTIONS.map((option) => (
              <option value={option.id}>{option.label}</option>
            ))}
          </select>
        </label>
        <span class="admin-toggle-row__sep" aria-hidden="true">|</span>
        <label class="admin-inline-field" for="ui-article-meta-date-granularity">
          <span class="admin-inline-field__label">粒度：</span>
          <select
            id="ui-article-meta-date-granularity"
            class="admin-inline-field__input"
            style="width: 116px; min-width: 116px;"
            title="默认仅日期；frontmatter 可覆盖；无时分回退日期"
          >
            {ADMIN_ARTICLE_DATE_GRANULARITY_OPTIONS.map((option) => (
              <option value={option.id}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>
    </div>

    <div class="admin-meta-group">
      <p class="admin-meta-group__label">附加信息</p>
      <div class="admin-toggle-row-group__line">
        <label class="admin-toggle-row" for="ui-article-meta-show-tags">
          <input id="ui-article-meta-show-tags" type="checkbox" />
          <span>显示标签</span>
        </label>
        <label class="admin-toggle-row" for="ui-article-meta-show-word-count">
          <input id="ui-article-meta-show-word-count" type="checkbox" />
          <span>显示字数</span>
        </label>
        <label class="admin-toggle-row" for="ui-article-meta-show-reading-time">
          <input id="ui-article-meta-show-reading-time" type="checkbox" />
          <span>显示阅读时长</span>
        </label>
      </div>
    </div>

    <div class="admin-meta-group">
      <p class="admin-meta-group__label">列表卡片</p>
      <div class="admin-toggle-row-group__line">
        <label class="admin-inline-field" for="ui-card-date-display">
          <span class="admin-inline-field__label">日期显示：</span>
          <select id="ui-card-date-display" class="admin-inline-field__input">
            {ADMIN_ARTICLE_DATE_DISPLAY_OPTIONS.map((option) => (
              <option value={option.id}>{option.label}</option>
            ))}
          </select>
        </label>
      </div>
    </div>

    <p class="admin-help admin-help--article-meta-preview">
      预览：<code id="article-meta-preview-value" class="admin-help__preview-value">{'更新于：2026-03-20 · #Astro\u00A0\u00A0#写作 · 共 2,416 字 · 约 6 分钟'}</code>
    </p>
  </div>

  <div class="admin-subgroup admin-subgroup--pagination">
    <p class="admin-subtitle">
      <span class="admin-subtitle__main">列表分页</span>
      <span class="admin-subtitle__hint">（关闭后整页排下去；开启时每页 {ADMIN_PAGINATION_PAGE_SIZE_MIN}-{ADMIN_PAGINATION_PAGE_SIZE_MAX} 条）</span>
    </p>
    <div class="admin-pagination-grid">
      {ADMIN_PAGINATION_PAGE_OPTIONS.map((option) => (
        <div class="admin-pagination-row" data-pagination-scope={option.id}>
          <span class="admin-pagination-row__page">
            {option.path ? <code>{option.path}</code> : null}
            {option.label}
          </span>
          <label class="admin-toggle-row admin-toggle-row--compact" for={`page-pagination-${option.id}-enabled`}>
            <input
              id={`page-pagination-${option.id}-enabled`}
              type="checkbox"
              data-pagination-enabled
            />
            <span>启用</span>
          </label>
          <label class="admin-inline-field admin-pagination-row__size" for={`page-pagination-${option.id}-size`}>
            <span class="admin-inline-field__label">每页</span>
            <input
              id={`page-pagination-${option.id}-size`}
              class="admin-inline-field__input admin-pagination-row__number"
              type="number"
              min={ADMIN_PAGINATION_PAGE_SIZE_MIN}
              max={ADMIN_PAGINATION_PAGE_SIZE_MAX}
              step="1"
              inputmode="numeric"
              data-pagination-size
            />
            <span class="admin-inline-field__label">条</span>
          </label>
        </div>
      ))}
    </div>
    <p class="admin-help">
      公开页仍会完整输出所有条目，只在浏览器里按页收起；关闭分页或禁用脚本时整页可见。
    </p>
  </div>

  {/*
    RSS 订阅控制列表页描述行里的 RSS 链接：总开关在标题行最右，
    三个页面各自勾选；总开关关闭时三个一起隐藏并置灰。
  */}
  <div class="admin-subgroup admin-subgroup--list-rss">
    <div class="admin-label admin-label--split">
      <span class="admin-label__copy">
        <span class="admin-label__main">RSS 订阅</span>
        <span class="admin-label__hint">（列表页描述行；侧栏按钮见「侧栏设置」）</span>
      </span>
      <label class="admin-label__toggle" for="page-list-rss-enabled">
        <input id="page-list-rss-enabled" type="checkbox" checked />
        <span>展示</span>
      </label>
    </div>
    <div id="page-list-rss-group" class="admin-toggle-row-group">
      <label class="admin-toggle-row" for="page-list-rss-blog">
        <input id="page-list-rss-blog" type="checkbox" />
        <span><code>/blog/</code></span>
      </label>
      <label class="admin-toggle-row" for="page-list-rss-bits">
        <input id="page-list-rss-bits" type="checkbox" />
        <span><code>/bits/</code></span>
      </label>
      <label class="admin-toggle-row" for="page-list-rss-archive">
        <input id="page-list-rss-archive" type="checkbox" />
        <span><code>/archive/</code></span>
      </label>
    </div>
    <p class="admin-help">
      三个页面互不干扰；关掉总开关则一起隐藏（下面的勾选保留，便于随时恢复）。
    </p>
  </div>

  <div class="admin-subgroup admin-subgroup--view-stats">
    <p class="admin-subtitle">
      <span class="admin-subtitle__main">浏览数据</span>
      <span class="admin-subtitle__hint">（PV / UV ，默认关闭，由自定义脚本提供）</span>
    </p>
    <div class="admin-toggle-row-group">
      {viewStatsInlineFields.map((field) => (
        <div class="admin-toggle-row admin-toggle-row--with-inline-field">
          <label class="admin-toggle-row admin-toggle-row--compact" for={`ui-view-stats-show-${field.key}`}>
            <input id={`ui-view-stats-show-${field.key}`} type="checkbox" />
            <span>{field.toggleLabel}</span>
          </label>
          <span class="admin-toggle-row__sep" aria-hidden="true">|</span>
          <label class="admin-inline-field" for={`ui-view-stats-${field.key}-label`}>
            <span class="admin-inline-field__label">前缀：</span>
            <input
              id={`ui-view-stats-${field.key}-label`}
              class="admin-inline-field__input"
              type="text"
              maxlength={ADMIN_VIEW_STATS_LABEL_MAX_LENGTH}
              autocomplete="off"
              placeholder={field.placeholder}
            />
          </label>
        </div>
      ))}
    </div>
    <div class="admin-toggle-row-group">
      <label class="admin-toggle-row">
        <input id="ui-view-stats-on-article-meta" type="checkbox" />
        <span>显示在文章元信息行</span>
      </label>
      <label class="admin-toggle-row">
        <input id="ui-view-stats-on-index-pages" type="checkbox" />
        <span>显示在博客 / 动态 / 更新 / 归档等列表页底部</span>
      </label>
    </div>
    <p class="admin-help admin-help--view-stats-preview">
      预览（文章元信息行）：<code id="view-stats-preview-meta" class="admin-help__preview-value">浏览 1,234 · 访客 456</code><br />
      预览（页面底部）：<code id="view-stats-preview-footer" class="admin-help__preview-value">浏览 1,234 · 访客 456</code>
    </p>
    <p class="admin-help">
      数据由 <code>src/scripts/view-stats.ts</code> 接入，空值时不显示。
    </p>
  </div>

  <div class="admin-subgroup">
    <p class="admin-subtitle">
      <span class="admin-subtitle__main">浮动操作列</span>
      <span class="admin-subtitle__hint">（选择右下角显示的图标；阅读模式仅文章与小记页可用）</span>
    </p>
    <div class="admin-sidebar-icon-grid" role="group" aria-label="浮动操作列按钮显隐">
      <label class="admin-sidebar-icon-toggle" for="ui-reading-entry" title="显示阅读模式入口">
        <input id="ui-reading-entry" type="checkbox" aria-label="显示阅读模式入口" title="显示阅读模式入口" />
        <span
          class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-sidebar-icon-toggle__button"
          aria-hidden="true"
        >
          <UiIcon name="book-open" size={18} strokeWidth={2} />
        </span>
      </label>
      <label class="admin-sidebar-icon-toggle" for="ui-float-stack-show-resume-reading" title="显示「回到上次阅读位置」">
        <input
          id="ui-float-stack-show-resume-reading"
          type="checkbox"
          aria-label="显示回到上次阅读位置"
          title="显示「回到上次阅读位置」"
        />
        <span
          class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-sidebar-icon-toggle__button"
          aria-hidden="true"
        >
          <UiIcon name="resume-reading" size={18} strokeWidth={2} />
        </span>
      </label>
      <label class="admin-sidebar-icon-toggle" for="ui-float-stack-show-scroll-top" title="显示「回到顶部」">
        <input
          id="ui-float-stack-show-scroll-top"
          type="checkbox"
          aria-label="显示回到顶部"
          title="显示「回到顶部」"
        />
        <span
          class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-sidebar-icon-toggle__button"
          aria-hidden="true"
        >
          <UiIcon name="chevron-up" size={18} strokeWidth={2} />
        </span>
      </label>
    </div>
  </div>

  <div class="admin-subgroup">
    <p class="admin-subtitle">
      <span class="admin-subtitle__main">/bits/页默认作者</span>
    </p>
    <div class="admin-author-image">
      <div class="admin-author-image__fields">
        <label class="admin-field">
          <span class="admin-label">
            <span class="admin-label__main">默认作者名</span>
          </span>
          <input class="admin-field__control" id="page-bits-author-name" type="text" autocomplete="off" />
        </label>
        <div class="admin-field">
          <span class="admin-label">
            <label class="admin-label__main" for="page-bits-author-avatar">默认头像</label>
            <span class="admin-label__hint">（相对路径）</span>
          </span>
          <div class="admin-images-field-input">
            <input class="admin-field__control" id="page-bits-author-avatar" type="text" autocomplete="off" />
            <button
              class="admin-btn admin-btn--ghost"
              type="button"
              data-admin-images-open="page.bits.defaultAuthor.avatar"
              aria-label="选择 Bits 默认头像"
            >
              选择
            </button>
          </div>
        </div>
      </div>
      <div class="admin-author-image__preview" aria-label="默认头像预览">
        <p class="admin-images-field-preview-label">预览头像</p>
        <div
          class="admin-images-field-preview admin-images-field-preview--avatar"
          data-admin-images-preview="page.bits.defaultAuthor.avatar"
          hidden
        >
          <img alt="" loading="lazy" decoding="async" data-admin-images-preview-img="page.bits.defaultAuthor.avatar" />
        </div>
      </div>
    </div>
  </div>
</fieldset>
