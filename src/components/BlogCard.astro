---
import { createWithBase } from '../utils/format';
import { getSiteTimezone } from '../utils/site-timezone';
import { resolveArticleDateItems } from '../lib/display-date';
import { isRoutableTagKey, toTagKey } from '../lib/tags';
import { getThemeSettings, type ArticleDateGranularity, type ArticleMetaSettings } from '../lib/theme-settings';
import { resolveEntrySeriesSlots } from '../lib/entry-display';
import { getSeriesFilterHref, getSeriesTagKey } from '../lib/blog-series';
import EntryTitleLine from './EntryTitleLine.astro';

const {
  href,
  title,
  excerpt,
  dateGranularity,
  date,
  dateText,
  dateHasTime = false,
  publishedAt = null,
  publishedAtText,
  publishedAtHasTime = false,
  updatedAt = null,
  updatedAtText,
  updatedAtHasTime = false,
  dateDisplay,
  visibleTags = [],
  badge = '随笔',
  versionGroup = null,
  versionLabel = null,
  versionName = null,
  seriesName = null,
  seriesIndex = null,
  seriesTotal = null,
  seriesSlug = null,
  slug = '',
  articleMetaSettings
} = Astro.props as {
  href: string;
  title: string;
  excerpt?: string | null;
  dateGranularity?: ArticleDateGranularity;
  date: Date;
  dateText?: string;
  dateHasTime?: boolean;
  publishedAt?: Date | null;
  publishedAtText?: string;
  publishedAtHasTime?: boolean;
  updatedAt?: Date | null;
  updatedAtText?: string;
  updatedAtHasTime?: boolean;
  dateDisplay?: 'published' | 'updated' | 'both';
  visibleTags?: string[];
  badge?: string;
  versionGroup?: string | null;
  versionLabel?: string | null;
  versionName?: string | null;
  versionSummary?: string | null;
  versionOrder?: number | null;
  /** 系列显示名 / 阅读序号 / 成员总数；没有系列时三个都传 null。 */
  seriesName?: string | null;
  seriesIndex?: number | null;
  seriesTotal?: number | null;
  /** 系列稳定键（frontmatter `series`），用来生成 canonical 筛选链接。 */
  seriesSlug?: string | null;
  slug?: string;
  articleMetaSettings: ArticleMetaSettings;
};

const {
  settings: { ui }
} = getThemeSettings();
const seriesTagKey = seriesSlug ? getSeriesTagKey(seriesSlug) : '';
/**
 * 槽位判定与首页条目共用一处实现（`resolveEntrySeriesSlots`）：
 * `pill` / `prefix` 由标题行承担系列呈现，`meta` 落到元信息行，`hidden` 什么都不做。
 */
const {
  showInTitle: showSeriesInTitle,
  showInMeta: showSeriesInMeta,
  orderText: seriesOrderText
} = resolveEntrySeriesSlots(
  { name: seriesName, slug: seriesSlug, index: seriesIndex, total: seriesTotal },
  ui
);
const shouldShowMetaLine = articleMetaSettings.showDate
  || (articleMetaSettings.showTags && visibleTags.length > 0)
  || showSeriesInMeta;
const timeZone = getSiteTimezone();
const dateItems = resolveArticleDateItems({
  mode: dateDisplay ?? articleMetaSettings.dateDisplay ?? 'updated',
  timeZone,
  granularity: dateGranularity ?? articleMetaSettings.dateGranularity ?? 'date',
  date: { date, text: dateText, hasTime: dateHasTime },
  publishedAt: publishedAt ? { date: publishedAt, text: publishedAtText, hasTime: publishedAtHasTime } : undefined,
  updatedAt: updatedAt ? { date: updatedAt, text: updatedAtText, hasTime: updatedAtHasTime } : undefined,
  publishedLabel: articleMetaSettings.dateLabel ?? '发布于：'
});

// 卡片标签指向 `/blog/?tags=<key>`，与详情页一致。
const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const tagLinks = visibleTags.map((tag) => {
  const key = toTagKey(tag);
  return {
    label: tag,
    key,
    href: isRoutableTagKey(key) ? withBase(`/blog/?tags=${encodeURIComponent(key)}`) : null
  };
});
---

{/*
  `<a>` 不能嵌套 `<a>`：卡片本身是 `<div>`，由 `.list-item__stretch` 的 `::after`
  铺满整卡保证整块可点，卡片内的标签才是真链接。
*/}
<div
  class="list-item list-item--link"
  data-entry-item
  data-slug={slug || undefined}
>
  <div class="list-item__row">
    <EntryTitleLine
      surface="list"
      title={title}
      badge={badge}
      versionLabel={versionGroup ? versionLabel : null}
      versionName={versionGroup ? versionName : null}
      seriesName={showSeriesInTitle ? seriesName : null}
      seriesIndex={showSeriesInTitle ? seriesIndex : null}
      seriesTotal={showSeriesInTitle ? seriesTotal : null}
      titleAs="link"
      titleHref={href}
    />
  </div>
  {excerpt ? <p class="list-item__excerpt">{excerpt}</p> : null}
  {shouldShowMetaLine ? (
    <div class="meta-line meta-line--items">
      {articleMetaSettings.showDate ? (
        <span class="meta-line__item">
          {dateItems.map((item, index) => (
            <>
              {index > 0 ? <span class="meta-line__sep" aria-hidden="true">·</span> : null}
              <time
                datetime={item.iso}
                data-site-timezone={item.timeZone}
                data-date-kind={item.hasTime ? 'datetime' : 'date'}
                data-date-label={item.label}
                data-site-offset={item.timeZoneLabel}
                title={item.hasTime ? `${item.timeZoneLabel} · ${item.timeZone}` : undefined}
              >{`${item.label}${item.text}`}</time>
            </>
          ))}
        </span>
      ) : null}
      {showSeriesInMeta ? (
        <span class="meta-line__item meta-line__item--series">
          {/*
            系列成员是并列的独立文章：链接只是「按系列筛选」的入口，
            文案是「系列名 N/M」，不使用任何版本语义。
          */}
          <a
            class="entry-series-link"
            href={withBase(getSeriesFilterHref(seriesSlug ?? ''))}
            aria-label={`筛选系列 ${seriesName}`}
            data-article-series-link={seriesTagKey}
          >{seriesOrderText ? `${seriesName} ${seriesOrderText}` : seriesName}</a>
        </span>
      ) : null}
      {articleMetaSettings.showTags && tagLinks.length ? (
        <span class="meta-line__item meta-line__item--tags">
          {tagLinks.map((tag) =>
            tag.href ? (
              <a class="tag tag--link" href={tag.href} aria-label={`筛选标签 ${tag.label}`} data-article-tag-link={tag.key}>
                #{tag.label}
              </a>
            ) : (
              <span class="tag">#{tag.label}</span>
            )
          )}
        </span>
      ) : null}
    </div>
  ) : null}
</div>
