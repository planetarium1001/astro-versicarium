---
import { getVisibleBlogSeriesIndex } from '../lib/content';
import { getSeriesFilterHref, getSeriesTagKey } from '../lib/blog-series';
import { createWithBase } from '../utils/format';
import UiIcon from './UiIcon.astro';

/**
 * 文章页「同系列文章」提示条 + 抽屉。
 *
 * 结构与 `ArticleVersionNotice.astro` 完全镜像（同一批 `article-version-notice` /
 * `version-drawer` / `version-list` 类名，同一套 trigger/drawer/dialog-close 约定，
 * 同一个 `article-version-drawer.ts` 处理焦点与退场），这样两套抽屉的视觉与交互不会分叉。
 *
 * 语义上刻意与版本不同：系列成员是并列的独立文章，没有「最新 / 历史 / 查看最新版」，
 * 序号是「第 N 篇 / 共 M 篇」的阅读次序。文案里不得出现版本词汇。
 */
const { entryId, seriesSlug = null } = Astro.props as {
  /** 当前文章 entry id：用来在系列清单里定位「正在阅读」的那一项。 */
  entryId: string;
  /** frontmatter `series`；为空时不渲染任何 UI。 */
  seriesSlug?: string | null;
};

const slug = seriesSlug?.trim() ?? '';
const seriesIndex = slug ? await getVisibleBlogSeriesIndex() : null;
const series = (slug ? seriesIndex?.get(slug) : null) ?? null;
/**
 * 系列清单每个版本组只留最新版那一行，所以这里用 entryId 精确匹配：
 * 版本组的历史版本（同一内容的旧稿）不单独占一篇，也就不显示同系列抽屉。
 */
const member = series?.members.find((item) => item.entryId === entryId) ?? null;
// 单篇成不了系列：只有 1 个成员时没有「同系列」可言，整块不渲染。
const notice = series && member && series.members.length > 1 ? { series, member } : null;

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const drawerId = `article-series-drawer-${entryId.replaceAll('/', '-')}`;
---

{notice ? (
  <section class="article-version-notice article-series-notice" aria-label="系列信息" data-article-drawer>
    <div class="article-version-notice__row">
      <p class="article-version-notice__text">
        <span class="article-version-notice__meta">
          <span>同系列</span>
          <span aria-hidden="true">·</span>
          <span>{notice.series.name}</span>
          <span aria-hidden="true">·</span>
          <span>第 {notice.member.index} 篇 / 共 {notice.series.total} 篇</span>
        </span>
      </p>
      <button
        class="article-version-trigger"
        type="button"
        data-version-trigger
        aria-expanded="false"
        aria-controls={drawerId}
        aria-label={`打开同系列文章（共 ${notice.series.total} 篇）`}
      >
        <span class="article-version-trigger__label" aria-hidden="true">同系列</span>
        <span class="article-version-trigger__icon article-version-trigger__icon--wide" aria-hidden="true">
          <UiIcon name="chevron-left" size={16} strokeWidth={1.8} />
        </span>
        <span class="article-version-trigger__icon article-version-trigger__icon--narrow" aria-hidden="true">
          <UiIcon name="chevron-up" size={16} strokeWidth={1.8} />
        </span>
      </button>
    </div>

    <dialog
      class="version-drawer"
      id={drawerId}
      data-version-drawer
      aria-label={`同系列文章（共 ${notice.series.total} 篇）`}
    >
      <div class="version-drawer__panel">
        <div class="version-drawer__head">
          <h2 class="version-drawer__title" tabindex="-1">同系列文章（共 {notice.series.total} 篇）</h2>
          <button class="version-drawer__close" type="button" data-version-close data-dialog-close aria-label="关闭同系列文章">
            <UiIcon name="x" size={14} strokeWidth={1.8} />
          </button>
        </div>
        <ol class="version-list">
          {notice.series.members.map((item) => {
            const current = item.entryId === entryId;
            return (
              <li class:list={['version-item', current && 'is-current']}>
                {current ? (
                  <span class="version-item__main">
                    <span class="version-item__label">{item.index}/{notice.series.total}</span>
                    <span class="version-item__name">{item.title}</span>
                  </span>
                ) : (
                  <a class="version-item__main" href={withBase(item.href)}>
                    <span class="version-item__label">{item.index}/{notice.series.total}</span>
                    <span class="version-item__name">{item.title}</span>
                  </a>
                )}
                {current ? (
                  <span class="version-item__meta">
                    <span class="version-item__status">正在阅读</span>
                  </span>
                ) : null}
              </li>
            );
          })}
        </ol>
        {/*
          尾部入口是一个筛选动作而不是「继续阅读」：它跳到列表页并带上该系列的筛选键。
          字号与条目里的「正在阅读」同档，右对齐，避免抢过抽屉正文的注意力。
        */}
        <p class="article-series-notice__filter-row">
          <a
            class="article-series-notice__filter"
            href={withBase(getSeriesFilterHref(notice.series.slug))}
            data-article-series-filter={getSeriesTagKey(notice.series.slug)}
          >筛选当前系列</a>
        </p>
      </div>
    </dialog>
  </section>

  <script>
    import '../scripts/article-version-drawer.ts';
  </script>
) : null}
