---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createWithBase, getVisibleDevlogs, getVisibleProjects } from '../../lib/content';
import { getThemeSettings } from '../../lib/theme-settings';
import { joinPageSubtitleText } from '../../utils/format';
import { deriveEntryDescription, renderEntryBody } from '../../lib/entry-body';
import { getContentImageSrc } from '../../lib/content-image';
import { renderTrailingLinksHtml, type TrailingLink } from '../../lib/trailing-links';
import '../../styles/projects-page.css';

const [items, devlogs] = await Promise.all([getVisibleProjects(), getVisibleDevlogs()]);
const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
const {
  settings: { page }
} = getThemeSettings();

const pageTitleText = page.projects.title || '项目';
const subtitleText = joinPageSubtitleText(page.projects.subtitle, `共 ${items.length} 个项目`);
const pageDescription = joinPageSubtitleText(
  `${pageTitleText}列表`,
  page.projects.subtitle,
  `共 ${items.length} 个项目`
) ?? `${pageTitleText}列表`;

type ProjectCard = {
  id: string;
  title: string;
  subtitle: string | null;
  description: string | null;
  type: string | null;
  icon: string | null;
  /** 展示图路径（可为空）；卡片里以缩略图呈现 */
  image: string | null;
  hasBody: boolean;
  /** 正文 html（含末尾链接行标记）；无正文时为空串 */
  bodyHtml: string;
  /** 末尾链接组，按书写顺序；卡片在摘要下一行单独渲染 */
  links: TrailingLink[];
  updates: Array<{ id: string; title: string; dateText: string }>;
};

const cards: ProjectCard[] = await Promise.all(
  items.map(async (entry): Promise<ProjectCard> => {
    const body = entry.body ?? '';
    const hasBody = body.trim().length > 0;
    const { html, links } = hasBody
      ? await renderEntryBody(body, base)
      : { html: '', links: [] as TrailingLink[] };
    return {
      id: entry.id,
      title: entry.data.title,
      subtitle: entry.data.subtitle?.trim() || null,
      description: deriveEntryDescription(entry.data.description, body),
      type: entry.data.type?.trim() || null,
      icon: getContentImageSrc(entry.data.icon),
      image: getContentImageSrc(entry.data.image),
      hasBody,
      bodyHtml: html,
      links,
      updates: devlogs
        .filter((devlog) => devlog.data.projectSlug === entry.id)
        .map((devlog) => ({
          id: devlog.id,
          title: devlog.data.title,
          dateText: devlog.data.dateText
        }))
    };
  })
);
---

<BaseLayout title={pageTitleText} description={pageDescription} bodyClass="projects-page">
  <div class="page-header">
    <div class="page-heading">
      <h1 class="page-title">{pageTitleText}</h1>
      {subtitleText ? <span class="page-subtitle">{subtitleText}</span> : null}
    </div>
  </div>

  <div class="project-grid">
    {cards.map((card) => (
      <article
        class="project-card"
        id={card.id}
        data-project-card
        data-project-id={card.id}
      >
        <button
          class="project-card__main"
          type="button"
          data-project-open
          data-project-dialog={`project-dialog-${card.id}`}
          aria-haspopup="dialog"
          aria-label={`查看项目：${card.title}`}
        >
          {/*
            头部两列：图标在左，胶囊标题与副标题在右侧两行，两列顶部对齐；
            正文里展示图左浮动贴最左，文段从它右侧开始并绕开它。
          */}
          <span class="project-card__body">
            <span class="project-card__head">
              {card.icon ? (
                <span class="project-card__icon">
                  <img src={withBase(card.icon)} alt="" loading="lazy" decoding="async" />
                </span>
              ) : null}
              <span class="project-card__headings">
                <span class="project-card__title-row">
                  {card.type ? <span class="badge">{card.type}</span> : null}
                  <span class="project-card__title">{card.title}</span>
                </span>
                {card.subtitle ? <span class="project-card__subtitle">{card.subtitle}</span> : null}
              </span>
            </span>
            {card.image ? (
              <span class="project-card__image">
                <img src={withBase(card.image)} alt={card.title} loading="lazy" decoding="async" />
              </span>
            ) : null}
            {card.description ? <span class="project-card__description">{card.description}</span> : null}
          </span>
        </button>

        {/* 末尾链接组渲染在摘要下一行，与展开正文里的链接行共用同一套标记 */}
        {card.links.length > 0 ? <Fragment set:html={renderTrailingLinksHtml(card.links)} /> : null}
      </article>
    ))}
  </div>

  {cards.map((card) => (
    <dialog
      class="project-dialog"
      id={`project-dialog-${card.id}`}
      data-project-dialog-panel
      aria-labelledby={`project-dialog-title-${card.id}`}
    >
      <div class="project-dialog__inner">
        <div class="project-dialog__handle" aria-hidden="true"></div>
        <div class="project-dialog__head">
          {/* 与卡片同一套头部：图标在左，胶囊标题与副标题在右侧两行，顶部对齐 */}
          {card.icon ? (
            <span class="project-dialog__icon">
              <img src={withBase(card.icon)} alt="" loading="lazy" decoding="async" />
            </span>
          ) : null}
          <div class="project-dialog__title-wrap">
            <div class="project-dialog__title-row">
              {card.type ? <span class="badge">{card.type}</span> : null}
              <h2 class="project-dialog__title" id={`project-dialog-title-${card.id}`} tabindex="-1">{card.title}</h2>
            </div>
            {card.subtitle ? <p class="project-dialog__subtitle">{card.subtitle}</p> : null}
          </div>
          <button class="project-dialog__close" type="button" data-project-close aria-label={`关闭 ${card.title}`}>✕</button>
        </div>
        <div class="project-dialog__content">
          {card.hasBody && card.bodyHtml ? (
            <div class="prose project-dialog__prose" set:html={card.bodyHtml} />
          ) : (
            <p class="project-dialog__fallback">{card.description ?? '暂无描述。'}</p>
          )}
          {card.updates.length ? (
            <section class="project-updates" aria-label={`${card.title}更新日志`}>
              <h3 class="project-updates__title">更新日志</h3>
              <ul class="project-updates__list">
                {card.updates.map((update) => (
                  <li>
                    <time datetime={update.dateText}>{update.dateText}</time>
                    <a href={withBase(`/devlog/#${update.id}`)}>{update.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ) : null}
        </div>
      </div>
    </dialog>
  ))}

  <script>
    import '../../scripts/projects-dialog.ts';
  </script>
</BaseLayout>
