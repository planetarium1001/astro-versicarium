---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryTitleLine from '../../components/EntryTitleLine.astro';
import TagFilterHeader from '../../components/TagFilterHeader.astro';
import { createWithBase, getVisibleblogs, getVisibleDevlogs } from '../../lib/content';
import { getArchiveRows, groupArchiveRows } from '../../lib/archive';
import { buildArchiveScopePills } from '../../lib/archive-scope-pills';
import { collectTagScopedSummary, type TagSummary } from '../../lib/tags';
import { getThemeSettings } from '../../lib/theme-settings';
import { joinPageSubtitleText } from '../../utils/format';
import '../../styles/archive-page.css';

/**
 * `/archive/` 全站时间线。
 * 一级胶囊：全部 / 博客 / 项目 / 更新，默认「全部」。时间线只显示日期与条目行，按年月分组，不含 bits。
 * 标题跳转：博客到稳定 slug 或版本 dated URL，项目到对应版本的 /projects/#<anchor>，更新到 /devlog/#<entryId>。
 * 项目按文档版本成行；行内排版固定为「标题 + 淡色版本号」；开发日志行为「项目名: 标题」，
 * 版本名称是否显示由后台「条目版本」选项决定。
 * tag dialog 作用域跟随一级胶囊。无服务端分页，/archive/index.json 是客户端筛选与计数的唯一数据源。
 */
const {
  settings: { page, shell }
} = getThemeSettings();
const [rows, blogs, devlogs] = await Promise.all([
  getArchiveRows({ versionMode: page.archive.versionMode }),
  getVisibleblogs(),
  getVisibleDevlogs()
]);
const groups = groupArchiveRows(rows);

const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);

const pageTitleText = page.archive.title || '归档';
const pagination = page.pagination?.archive ?? { enabled: false, pageSize: 20 };
const totalCount = rows.length;
const blogCount = rows.filter((row) => row.kind === 'blog').length;
const projectRows = rows.filter((row) => row.kind === 'projects');
const projectCount = projectRows.length;
const devlogCount = rows.filter((row) => row.kind === 'devlog').length;
const subtitleText = joinPageSubtitleText(page.archive.subtitle, `共 ${totalCount} 篇内容`);
const pageDescription = joinPageSubtitleText(
  `${pageTitleText}列表`,
  page.archive.subtitle,
  `共 ${totalCount} 篇内容`
) ?? `${pageTitleText}列表`;

/**
 * 归档的 tag 取值域逐档收敛：
 * 博客用自身 tags；项目每个版本行都带项目显示名，供「项目」作用域的 `#项目` 过滤；
 * 更新只取项目名称，与 /devlog/ 的 `#项目` 一致；「全部」由时间线行推导，保证计数与可见行一致。
 */
const blogTags: TagSummary[] = collectTagScopedSummary('blog', blogs, (entry) => entry.data.tags);
const projectTags: TagSummary[] = collectTagScopedSummary('projects', projectRows, (row) => row.tags);
const devlogTags: TagSummary[] = collectTagScopedSummary('devlog', devlogs, (entry) => [
  entry.data.project
].filter(Boolean));
const allTags: TagSummary[] = collectTagScopedSummary('all', rows, (row) => row.tags);

const scopePills = buildArchiveScopePills({
  page,
  nav: shell.nav,
  totalCount,
  blogCount,
  projectCount,
  devlogCount
});

const tagPayload = { blog: blogTags, projects: projectTags, devlog: devlogTags, all: allTags };
---

<BaseLayout title={pageTitleText} description={pageDescription}>
  <div
    class="entry-filters archive-filters"
    data-entry-filters
    data-archive-timeline
    data-index-url="/archive/index.json"
    data-section-selector="[data-entry-section]"
    data-page-size={pagination.enabled ? String(pagination.pageSize) : undefined}
  >
    <TagFilterHeader
      pageTitleText={pageTitleText}
      subtitleText={subtitleText}
      rssHref={withBase('/blog/rss.xml')}
      pickerHref="#archive-timeline"
      fallbackListId="archive-timeline"
      dialogTitleId="archive-tag-dialog-title"
      searchAriaLabel={`搜索${pageTitleText}`}
      showRss={page.listRss.enabled !== false && page.listRss.archive !== false}
      tagOptions={allTags}
    />
  </div>

  {/*
    一级胶囊条，结构与语义对齐原 /bits/ 年份筛选胶囊（样式见共享的 scope-pills.css）：
    不带计数徽章（条目数放 aria-label），用 aria-pressed 表达选中态，
    外层胶囊内一个绝对定位滑块跟随激活项。
  */}
  <div
    class="scope-pills"
    data-archive-scope-bar
    role="group"
    aria-label="按作用域筛选归档"
  >
    <span class="scope-pills__cursor" data-archive-scope-cursor aria-hidden="true"></span>
    {scopePills.map((pill) => (
      <button
        class:list={['scope-pills__item', pill.id === 'all' && 'is-active']}
        type="button"
        data-archive-scope={pill.id}
        aria-label={`${pill.label === '全部' ? '显示全部归档' : `筛选${pill.label}，共 ${pill.count} 条`}`}
        aria-pressed={pill.id === 'all' ? 'true' : 'false'}
      >
        {pill.label}
      </button>
    ))}
  </div>

  <div id="archive-timeline" class="archive-timeline" data-entry-list data-archive-content>
    {groups.map((group) => (
      <section class="archive-group" data-entry-section data-archive-group>
        <h2 class="archive-group__label">{group.label}</h2>
        <div class="archive-timeline__list">
          {group.rows.map((row) => (
            <div
              class="archive-timeline__row"
              data-entry-item
              data-slug={row.key}
              data-archive-kind={row.kind}
              data-archive-key={row.key}
            >
              <time class="archive-timeline__date" datetime={row.dateText}>
                {row.dateText.slice(5)}
              </time>
              {/*
                整行一个链接：字段组合（项目名 / 标题 / 版本号等）可能重排，
                不能让标题单独成为 <a>，否则分隔符与胶囊会落在链接外。
              */}
              <a class="archive-timeline__entry" href={withBase(row.href)}>
                <EntryTitleLine
                  surface="archive"
                  kind={row.kind}
                  title={row.title}
                  project={row.project ?? null}
                  versionLabel={row.kind === 'blog' && !row.series ? null : row.versionLabel ?? null}
                  versionName={row.versionName ?? null}
                  titleTag="span"
                />
              </a>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <nav class="pagination" data-entry-pagination hidden aria-label={`${pageTitleText}分页`}>
    <div class="pagination__inner" data-entry-pagination-inner></div>
  </nav>

  <script is:inline type="application/json" id="archive-tag-scope-data" set:html={JSON.stringify(tagPayload)}></script>

  <script>
    import '../../scripts/entry-search.ts';
    import '../../scripts/archive-scope.ts';
  </script>
</BaseLayout>
