---
import Sidebar from '../components/Sidebar.astro';
import SiteFilings from '../components/SiteFilings.astro';
import ViewStats from '../components/ViewStats.astro';
import UiIcon from '../components/UiIcon.astro';
import globalStylesHref from '../styles/global.css?url';
import fontsDlcHref from '../styles/fonts.dlc.generated.css?url';
import { hasSiteUrl } from '../../site.config.mjs';
import { createWithBase } from '../utils/format';
import { resolveOgImageUrl } from '../utils/og-image';
import {
  ADMIN_DEFAULT_SIDEBAR_NAV_MODE_STORAGE_KEY,
  ADMIN_SHOW_TOP_NAV_STORAGE_KEY,
  ADMIN_SIDEBAR_NAV_MODE_STORAGE_KEY
} from '../lib/admin-console/ui-prefs-keys';
import {
  getThemeSettings,
  getSiteFaviconLinks,
  SCROLLBAR_GUTTER_INLINE_PX,
  type SidebarNavId
} from '../lib/theme-settings';
import { getSelectedAstroApiFonts, getTypographyStyleOverride } from '../lib/fonts/registry';
import { Font } from 'astro:assets';

const {
  title,
  description,
  image,
  ogType = 'website',
  canonicalPath = null,
  noindex = false,
  ogImageAlt,
  bodyClass,
  deferGlobalStyles = false,
  activeNavId,
  adminSidebarScope = 'default',
  tocRail = false
} = Astro.props as {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  /** 不含部署 base 的站点路径；传入时覆盖当前 URL 的 canonical。 */
  canonicalPath?: string | null;
  noindex?: boolean;
  ogImageAlt?: string;
  bodyClass?: string;
  deferGlobalStyles?: boolean;
  activeNavId?: SidebarNavId;
  adminSidebarScope?: 'default' | 'page';
  // 为 true 时预留第 4 列（文章右侧目录）并渲染 toc-rail 插槽；壳层宽度全局统一，不会移动左侧栏
  tocRail?: boolean;
};

const { settings } = getThemeSettings();
const fontCoverage = settings.ui.fontCoverage;
const siteTitle = settings.site.title;
const brandTitle = settings.shell.brandTitle ?? siteTitle;
/** 窄屏顶栏标题：未单独设置（shell.titleNarrow 为空）时与侧栏站点名一致。 */
const siteTitleNarrow = settings.shell.titleNarrow ?? brandTitle;
const metaDescription = description ?? settings.site.description;
const fullTitle = title ? `${title} | ${siteTitle}` : siteTitle;
const htmlLang = settings.site.defaultLocale || 'zh-CN';
const footerStartYear = settings.site.footer.startYear;
const footerShowCurrentYear = settings.site.footer.showCurrentYear;
const footerCopyright = settings.site.footer.copyright;
/** 窄屏顶栏站点标题宽度上限（后台可配，默认 35%），作为 CSS 变量写在 `<html>` 上。 */
const siteTitleMaxPercent = settings.site.titleMaxPercent;
/**
 * 窄屏浮动列到屏幕右侧的距离（后台可配，默认 6px，仅 900px 以下生效）。
 * 桌面固定用 :root 的 6px；窄屏由 layout.css 在 body 里读这个内联变量覆盖 --rail-action-offset。
 */
const siteRailOffsetPx = settings.site.railOffsetPx;
/**
 * 页面外缘间隙（后台可配，默认 41px）：内容盒到浏览器边缘的距离。
 * 换算 --page-inline 时扣掉 html 的 scrollbar-gutter: stable 占住的滚动条槽。
 */
const sitePageGapPx = settings.site.pageGapPx;
const pageInlinePx = sitePageGapPx - SCROLLBAR_GUTTER_INLINE_PX;
const showCodeLineNumbers = settings.ui.codeBlock.showLineNumbers;
const sidebarDividerVariant = settings.ui.layout.sidebarDivider;
// 非默认字体角色以 <html> 内联属性覆盖 global.css 的 :root tokens；默认态不输出，保持 global.css 为唯一默认来源。
const typographyStyleOverride = getTypographyStyleOverride(settings.ui.typography);
/**
 * `<html>` 内联声明：字体覆盖、窄屏站点标题宽度上限、页面外缘间隙、--page-inline
 * 与窄屏浮动列右侧距离。
 * 内联属性优先于 :root 与首页 critical CSS；窄屏由 global.css 在 body 覆写 --page-inline，
 * layout.css 在窄屏读 --rail-action-offset-narrow 覆盖 --rail-action-offset。
 */
const htmlStyleOverride = [
  typographyStyleOverride,
  `--site-title-max-inline: ${siteTitleMaxPercent}%`,
  `--page-gap-inline: ${sitePageGapPx}px`,
  `--page-inline: ${pageInlinePx}px`,
  `--rail-action-offset-narrow: ${siteRailOffsetPx}px`
].filter(Boolean).join('; ');
// 选中 astro-fonts-api 字体时渲染 <Font>（注入构建期生成的 @font-face 与 cssVariable）；默认态为空数组。
// 只渲染 config 期实际注册的 cssVariable（快照来自 vite.define）：dev 下热改 ui.json 的未注册
// 条目会让 <Font> 抛 FontFamilyNotFound 崩掉全站，此处跳过并提示重启。
const registeredFontCssVariables = new Set(
  String(import.meta.env.ASTRO_WHONO_FONT_CSS_VARIABLES ?? '').split(',').filter(Boolean)
);
const selectedApiFonts = getSelectedAstroApiFonts(settings.ui.typography);
const typographyApiFonts = selectedApiFonts.filter((font) =>
  registeredFontCssVariables.has(`--font-${font.id}`)
);
if (import.meta.env.DEV && typographyApiFonts.length !== selectedApiFonts.length) {
  console.warn(
    '[fonts] ui.typography 选中的字体未注册于本次启动的 fonts 配置，已跳过 <Font> 渲染；重启 dev server 生效。'
  );
}
const currentYear = new Date().getFullYear();
const yearRange = footerShowCurrentYear && currentYear > footerStartYear
  ? `${footerStartYear}-${currentYear}`
  : `${footerStartYear}`;
const base = import.meta.env.BASE_URL ?? '/';
const pathname = Astro.url.pathname;
const withBase = createWithBase(base);
const canonical = (hasSiteUrl && Astro.site)
  ? new URL(canonicalPath ? withBase(canonicalPath) : Astro.url.pathname, Astro.site).toString()
  : null;
// og:image 需要绝对地址：外链原样返回；站内路径补部署 base 后再按站点 origin 绝对化。
// 未配置 SITE_URL 时拿不到 origin，此时不输出 og:image，twitter card 回落到 summary。
// 未传 image 的页面不输出 og:image；只有显式配置了 ogImage 的页面才有分享图。
const ogImage = (hasSiteUrl && Astro.site && image)
  ? resolveOgImageUrl(image, base, Astro.site)
  : null;
const faviconLinks = getSiteFaviconLinks(settings.site.favicon);
const bodyClassNames = typeof bodyClass === 'string' ? bodyClass.split(/\s+/).filter(Boolean) : [];
const isAdminPage = bodyClassNames.includes('admin-page');
// 长阅读/列表页才输出浮动按钮列；构建期判路由，带 base 前缀部署也能命中
const basePrefix = base.endsWith('/') ? base.slice(0, -1) : base;
const routePath = basePrefix && pathname.startsWith(basePrefix)
  ? pathname.slice(basePrefix.length) || '/'
  : pathname;
// 首页同样是长滚动页，与列表页、文章页一样需要浮动列（回到顶部 / 回到上次阅读位置）；
// 目录按钮的显隐由 article-toc.ts 按窄屏与内联目录是否存在单独判定。
const showFloatStack = !isAdminPage
  && (routePath === '/' || /^\/(?:archive|projects|bits|blog|devlog)(?:\/|$)/.test(routePath));
// 阅读模式入口开关（Theme Console →「浮动操作列」）
const showReaderToggle = settings.ui.readingMode.showEntry;
// 同组的另外两个按钮开关
const showResumeReadingButton = settings.ui.floatStack.showResumeReading;
const showScrollTopButton = settings.ui.floatStack.showScrollTop;
const hasFloatButtons = showReaderToggle || showResumeReadingButton || showScrollTopButton;
// 浏览数据（PV / UV）：文章详情页在元信息行（ArticleLayout），其余页面在页脚；
// 数字由用户脚本填，未填值时不占位。
const viewStats = settings.ui.viewStats;
const showViewStatsSlots = viewStats.showPv || viewStats.showUv;
const isArticlePage = bodyClassNames.includes('article-page');
const showIndexViewStats = showViewStatsSlots
  && viewStats.onIndexPages
  && !isAdminPage
  && !isArticlePage;
const viewStatsScope = routePath === '/' ? 'home' : (routePath.split('/')[1] || 'other');
const showViewStatsScript = showViewStatsSlots && !isAdminPage;
const isDev = import.meta.env.DEV;
const isDevAdminPage = isAdminPage && isDev;
const adminDevState = isAdminPage ? (isDev ? 'true' : 'false') : undefined;
const isPageScopedAdminSidebar = isAdminPage && adminSidebarScope === 'page';
const shouldLoadAdminSidebarNavMode = isDev && !isPageScopedAdminSidebar;
const devUiPrefsStylesHref = isDev && !isAdminPage
  ? (await import('../styles/components/admin/dev-ui-prefs.css?url')).default
  : null;
const adminSidebarNavModeScriptHref = shouldLoadAdminSidebarNavMode
  ? (await import('../scripts/admin-sidebar-nav-mode.ts?url')).default
  : null;
const adminUiPrefsScriptHref = isDevAdminPage
  ? (await import('../scripts/admin-ui-prefs.ts?url')).default
  : null;
---

<!doctype html>
<html lang={htmlLang} style={htmlStyleOverride}>
  <head>
    <script is:inline>
      (() => {
        // 与 src/scripts/sidebar-theme.ts 保持同一主题偏好契约，避免首屏与运行时状态漂移。
        const themeKey = 'theme';
        const modeKey = 'theme-mode';
        let storedMode = null;
        let legacyTheme = null;
        try {
          storedMode = localStorage.getItem(modeKey);
          legacyTheme = localStorage.getItem(themeKey);
        } catch (_) {
          // 隐私模式/禁用存储：读不到偏好就按 system 走，首屏直接渲染默认主题。
        }
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        const mode = storedMode === 'system' || storedMode === 'dark' || storedMode === 'light'
          ? storedMode
          : (legacyTheme === 'dark' || legacyTheme === 'light' ? legacyTheme : 'system');
        const theme = mode === 'system' ? (prefersDark ? 'dark' : 'light') : mode;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeMode = mode;
      })();
    </script>
    {isDev ? (
      <script
        is:inline
        define:vars={{
          isAdminPage,
          isPageScopedAdminSidebar,
          defaultSidebarNavModeKey: ADMIN_DEFAULT_SIDEBAR_NAV_MODE_STORAGE_KEY,
          sidebarNavModeKey: ADMIN_SIDEBAR_NAV_MODE_STORAGE_KEY,
          showTopNavKey: ADMIN_SHOW_TOP_NAV_STORAGE_KEY
        }}
      >
        (() => {
          const root = document.documentElement;

          if (!isPageScopedAdminSidebar) {
            let storedNavMode = null;
            let storedDefaultNavMode = null;
            try {
              storedNavMode = sessionStorage.getItem(sidebarNavModeKey);
            } catch (_) {
              // sessionStorage 不可用时视为没有会话内选择，继续回退到 localStorage。
            }
            if (storedNavMode === 'admin' || storedNavMode === 'public') {
              root.dataset.adminNavMode = storedNavMode;
            } else {
              try {
                storedDefaultNavMode = localStorage.getItem(defaultSidebarNavModeKey);
              } catch (_) {
                // 隐私模式禁用存储：读不到默认值就按 public 渲染导航，不阻塞首屏。
              }
              root.dataset.adminNavMode = storedDefaultNavMode === 'admin' ? 'admin' : 'public';
            }
          }

          if (!isAdminPage) return;

          if (isPageScopedAdminSidebar) {
            root.dataset.adminSidebar = 'collapsed';
            root.dataset.adminSidebarScope = 'page';
          } else {
            root.dataset.adminSidebar = 'expanded';
            delete root.dataset.adminSidebarScope;
          }

          let storedShowTopNav = null;
          try {
            storedShowTopNav = localStorage.getItem(showTopNavKey);
          } catch (_) {
            // 隐私模式禁用存储：读不到开关值就按「不显示顶栏」渲染。
          }
          if (storedShowTopNav === 'true') {
            root.dataset.adminShowTopNav = 'true';
          } else {
            delete root.dataset.adminShowTopNav;
          }
        })();
      </script>
    ) : null}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {faviconLinks.map((link) => (
      <link rel={link.rel} type={link.type} sizes={link.sizes} href={withBase(link.href)} />
    ))}
    <title>{fullTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={fullTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {
      deferGlobalStyles ? (
        <>
          <link rel="preload" href={globalStylesHref} as="style" />
          <link
            rel="stylesheet"
            href={globalStylesHref}
            media="print"
            onload="this.onload=null;this.media='all'"
          />
          <noscript><link rel="stylesheet" href={globalStylesHref} /></noscript>
        </>
      ) : (
        <link rel="stylesheet" href={globalStylesHref} />
      )
    }
    {
      fontCoverage === 'full' ? (
        <>
          <link rel="preload" href={fontsDlcHref} as="style" />
          <link
            rel="stylesheet"
            href={fontsDlcHref}
            media="print"
            onload="this.onload=null;this.media='all'"
          />
          <noscript><link rel="stylesheet" href={fontsDlcHref} /></noscript>
        </>
      ) : null
    }
    {devUiPrefsStylesHref ? <link rel="stylesheet" href={devUiPrefsStylesHref} /> : null}
    {typographyApiFonts.map((font) => <Font cssVariable={`--font-${font.id}`} />)}
    <slot name="head" />
  </head>
  <body
    class={bodyClass}
    data-code-line-numbers={showCodeLineNumbers ? undefined : 'off'}
    data-dev-ui={isDev ? 'true' : undefined}
    data-admin-dev={adminDevState}
  >
    <a class="skip-link" href="#content">跳到内容</a>
    <div class="shell" data-sidebar-divider={sidebarDividerVariant} data-toc={tocRail ? 'true' : undefined}>
      <Sidebar
        siteTitle={brandTitle}
        siteTitleNarrow={siteTitleNarrow}
        activeNavId={activeNavId}
        isAdminContext={isAdminPage}
        isDev={isDev}
        adminSidebarScope={isPageScopedAdminSidebar ? 'page' : 'default'}
      />
      <div class="divider" aria-hidden="true"></div>
      <main id="content" class="content" tabindex="-1">
        <div class="content__inner">
          <slot />
          <footer class="site-footer">
            {showIndexViewStats ? (
              <ViewStats
                variant="footer"
                scope={viewStatsScope}
                path={pathname}
                route={routePath}
                title={title}
                showPv={viewStats.showPv}
                pvLabel={viewStats.pvLabel}
                showUv={viewStats.showUv}
                uvLabel={viewStats.uvLabel}
              />
            ) : null}
            © {yearRange} {footerCopyright}
            <SiteFilings filings={settings.site.filings} />
          </footer>
        </div>
      </main>
      {tocRail ? <slot name="toc-rail" /> : null}
    </div>
    {showFloatStack && hasFloatButtons ? (
      <div class="float-stack" data-float-stack>
        {/*
          按钮只保留 aria-label，不写 title：华为 ArkWeb 内核会把 title 当原生长按提示，
          触摸时可能吞掉首次点按（Chrome / Via 不弹）。桌面悬停提示暂时取消，
          若需要恢复，改用仓库的 [data-tooltip] 机制而不是 title。
        */}
        {/*
          目录按钮：排在最上端，其余按钮位置不随它的显隐变化（浮动列自下而上堆叠）。
          初始 hidden，只有 article-toc.ts 在窄屏且页面确有内联目录时才显示。
        */}
        <button
          id="toc-jump"
          class="float-stack__button"
          type="button"
          aria-label="查看目录"
          hidden
        >
          <UiIcon name="list" class="icon" />
        </button>
        {showReaderToggle ? (
          <button
            id="reader-toggle"
            class="float-stack__button reader-toggle"
            type="button"
            aria-label="阅读模式"
            aria-pressed="false"
            hidden
          >
            <UiIcon name="book-open" class="icon icon-book-open" />
            <UiIcon name="book-closed" class="icon icon-book-closed" />
          </button>
        ) : null}
        {showResumeReadingButton ? (
          <button
            id="resume-reading"
            class="float-stack__button"
            type="button"
            aria-label="回到上次阅读位置"
            hidden
          >
            <UiIcon name="resume-reading" class="icon" />
          </button>
        ) : null}
        {showScrollTopButton ? (
          <button
            id="scroll-top"
            class="float-stack__button"
            type="button"
            aria-label="回到顶部"
            aria-disabled="true"
          >
            <UiIcon name="chevron-up" class="icon" />
          </button>
        ) : null}
      </div>
    ) : null}
    <script>
      import '../scripts/input-modality.ts';
      import '../scripts/article-dates.ts';
      import '../scripts/page-subtitle.ts';
      import '../scripts/sidebar-theme.ts';
      import '../scripts/sidebar-rail-nav.ts';
      import '../scripts/sidebar-floating-actions.ts';
      import '../scripts/sidebar-reading.ts';
    </script>
    {showViewStatsScript ? (
      <script>
        import '../scripts/view-stats';
        import { dispatchViewStatsReady } from '../lib/view-stats';

        dispatchViewStatsReady();
      </script>
    ) : null}
    {adminSidebarNavModeScriptHref ? (
      <script is:inline type="module" src={adminSidebarNavModeScriptHref}></script>
    ) : null}
    {adminUiPrefsScriptHref ? (
      <script is:inline type="module" src={adminUiPrefsScriptHref}></script>
    ) : null}
  </body>
</html>
