---
import BaseLayout from './BaseLayout.astro';
import ArticleToc from '../components/ArticleToc.astro';
import ArticleVersionNotice from '../components/ArticleVersionNotice.astro';
import ViewStats from '../components/ViewStats.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/article.css';
import { getBlogDerivedText, type BlogEntry, type BlogRouteEntry } from '../lib/content';
import { containsMarkdownMath } from '../lib/markdown-math';
import {
  MARKDOWN_MATH_STYLESHEET_DATA_ATTR,
  MARKDOWN_MATH_STYLESHEET_HREF,
  MARKDOWN_MATH_STYLESHEET_ID
} from '../lib/markdown-math-styles';
import type {
  ArticleDateGranularity,
  ArticleMetaSettings,
  SidebarNavId,
  ViewStatsSettings
} from '../lib/theme-settings';
import { createWithBase } from '../utils/format';
import { getSiteTimezone } from '../utils/site-timezone';
import { resolveArticleDateItems } from '../lib/display-date';
import { truncateText } from '../utils/excerpt';
import { isRoutableTagKey, toTagKey } from '../lib/tags';

type ArticleNeighborLink = {
  href: string;
  title: string;
};

const {
  entry,
  route,
  prev,
  next,
  articleMetaSettings,
  dateGranularity,
  viewStatsSettings,
  visibleTags = [],
  headings = []
} = Astro.props as {
  entry: BlogEntry;
  route: BlogRouteEntry;
  prev: ArticleNeighborLink | null;
  next: ArticleNeighborLink | null;
  articleMetaSettings: ArticleMetaSettings;
  dateGranularity?: ArticleDateGranularity;
  viewStatsSettings: ViewStatsSettings;
  visibleTags?: string[];
  headings?: { depth: number; slug: string; text?: string }[];
};

// 目录只收有锚点文本的 h2/h3
const tocHeadings = headings.filter(
  (heading) => (heading.depth === 2 || heading.depth === 3) && heading.slug && (heading.text ?? '').trim()
);
const hasToc = tocHeadings.length > 0;

const entryTags: string[] = entry?.data?.tags ?? [];
const base = import.meta.env.BASE_URL ?? '/';
const withBase = createWithBase(base);
// 详情页标签统一指向列表页的 `?tags=<key>`，由 entry-search.ts 即时筛选。
const tagLinks = visibleTags.map((tag) => {
  const key = toTagKey(tag);
  return {
    label: tag,
    key,
    href: isRoutableTagKey(key) ? withBase(`/blog/?tags=${encodeURIComponent(key)}`) : null
  };
});
const ogImageValue = entry.data.ogImage;
const ogImage = ogImageValue == null
  ? null
  : typeof ogImageValue === 'string'
    ? ogImageValue
    : ogImageValue.src;
const derivedText = getBlogDerivedText(entry);
const rawDescription = entry?.data?.description?.trim?.() ?? '';
const description = rawDescription || truncateText(derivedText.excerpt, 90);
// 详情页导航高亮固定为「博客」。
const activeNavId: SidebarNavId = 'blog';
const hasMath = containsMarkdownMath(entry.body ?? '');
const katexStylesheetAttrs = { [MARKDOWN_MATH_STYLESHEET_DATA_ATTR]: 'true' };
const updatedAt = entry.data.updatedAt ?? null;
const dateItems = resolveArticleDateItems({
  mode: entry.data.articleDateDisplay ?? articleMetaSettings.dateDisplay ?? 'updated',
  timeZone: getSiteTimezone(),
  granularity: dateGranularity ?? articleMetaSettings.dateGranularity ?? 'date',
  date: {
    date: entry.data.date,
    text: entry.data.dateText,
    hasTime: entry.data.dateHasTime
  },
  publishedAt: entry.data.publishedAt
    ? {
        date: entry.data.publishedAt,
        text: entry.data.publishedAtText,
        hasTime: entry.data.publishedAtHasTime
      }
    : undefined,
  updatedAt: updatedAt
    ? {
        date: updatedAt,
        text: entry.data.updatedAtText,
        hasTime: entry.data.updatedAtHasTime
      }
    : undefined,
  publishedLabel: articleMetaSettings.dateLabel ?? '发布于：',
  forceVersionDate: route.isLatest === false
});
const articleReadingStats = articleMetaSettings.showWordCount || articleMetaSettings.showReadingTime
  ? (() => {
      const wordCount = derivedText.plainText.replace(/\s+/g, '').length;
      return {
        wordCount,
        readingMinutes: Math.max(1, Math.ceil(wordCount / 320))
      };
    })()
  : { wordCount: 0, readingMinutes: 0 };
const numberFormatter = new Intl.NumberFormat('zh-CN');
// 浏览数据槽位由用户脚本填值，未填值时整组不占位
const viewStats = viewStatsSettings;
const showViewStatsInMeta = viewStats.onArticleMeta && (viewStats.showPv || viewStats.showUv);
const shouldShowMetaLine = articleMetaSettings.showDate
  || (articleMetaSettings.showTags && visibleTags.length > 0)
  || articleMetaSettings.showWordCount
  || articleMetaSettings.showReadingTime
  || showViewStatsInMeta;

---

<BaseLayout
  title={entry.data.title}
  description={description}
  image={ogImage ?? undefined}
  ogImageAlt={entry.data.ogImageAlt}
  canonicalPath={route.canonicalPath}
  noindex={route.noindex}
  ogType="article"
  bodyClass="article-page immersive-page"
  activeNavId={activeNavId}
  tocRail={hasToc}
>
  {hasToc ? (
    <Fragment slot="toc-rail">
      <ArticleToc headings={tocHeadings} variant="rail" />
    </Fragment>
  ) : null}
  <Fragment slot="head">
    <meta property="article:published_time" content={(entry.data.publishedAt ?? entry.data.date).toISOString()} />
    {updatedAt ? <meta property="article:modified_time" content={updatedAt.toISOString()} /> : null}
    {entryTags.map((tag: string) => (
      <meta property="article:tag" content={tag} />
    ))}
    {hasMath ? (
      <link
        id={MARKDOWN_MATH_STYLESHEET_ID}
        rel="stylesheet"
        href={MARKDOWN_MATH_STYLESHEET_HREF}
        {...katexStylesheetAttrs}
      />
    ) : null}
    {hasToc ? (
      <script is:inline>
        // 目录状态须在首绘前落到 <html>：手动收起过就保持收起，否则先按收起态渲染
        // （data-toc-intro），由 article-toc.ts 撤掉后平滑展开；键名与 TOC_COLLAPSED_KEY 一致。
        (() => {
          try {
            const root = document.documentElement;
            if (window.localStorage.getItem('astro-whono:toc-collapsed') === '1') {
              root.dataset.tocCollapsed = 'true';
              return;
            }
            const reduceMotion = typeof window.matchMedia === 'function'
              && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (!reduceMotion) root.dataset.tocIntro = 'true';
          } catch (_) {}
        })();
      </script>
    ) : null}
  </Fragment>
  <div class="article-header">
    <h1 class="page-title">{entry.data.title}</h1>
    {shouldShowMetaLine ? (
      <div class="meta-line meta-line--items">
        {articleMetaSettings.showDate ? (
          <span class="meta-line__item">
            {dateItems.map((item, index) => (
              <>
                {index > 0 ? <span class="meta-line__sep" aria-hidden="true">·</span> : null}
                <time
                  datetime={item.iso}
                  data-site-timezone={item.timeZone}
                  data-date-kind={item.hasTime ? 'datetime' : 'date'}
                  data-date-label={item.label}
                data-site-offset={item.timeZoneLabel}
                  title={item.hasTime ? `${item.timeZoneLabel} · ${item.timeZone}` : undefined}
                >{`${item.label}${item.text}`}</time>
              </>
            ))}
          </span>
        ) : null}
        {articleMetaSettings.showTags && tagLinks.length ? (
          <span class="meta-line__item meta-line__item--tags">
            {tagLinks.map((tag) =>
              tag.href ? (
                <a class="tag tag--link" href={tag.href} aria-label={`筛选标签 ${tag.label}`} data-article-tag-link={tag.key}>
                  #{tag.label}
                </a>
              ) : (
                <span class="tag">#{tag.label}</span>
              )
            )}
          </span>
        ) : null}
        {articleMetaSettings.showWordCount ? (
          <span class="meta-line__item meta-line__item--desktop-meta">
            共 {numberFormatter.format(articleReadingStats.wordCount)} 字
          </span>
        ) : null}
        {articleMetaSettings.showReadingTime ? (
          <span class="meta-line__item meta-line__item--desktop-meta">
            约 {numberFormatter.format(articleReadingStats.readingMinutes)} 分钟
          </span>
        ) : null}
        {showViewStatsInMeta ? (
          <ViewStats
            scope="article"
            path={Astro.url.pathname}
            route={route.canonicalPath}
            title={entry.data.title}
            showPv={viewStats.showPv}
            pvLabel={viewStats.pvLabel}
            showUv={viewStats.showUv}
            uvLabel={viewStats.uvLabel}
          />
        ) : null}
      </div>
    ) : null}
  </div>

  <ArticleVersionNotice route={route} />

  {hasToc ? <ArticleToc headings={tocHeadings} variant="inline" /> : null}

  <div class="prose">
    <slot />
  </div>
  {(prev || next) ? (
    <nav class="prev-next" aria-label="上一篇/下一篇">
      <div class="prev-next__item prev-next__item--prev">
        {prev ? (
          <a class="prev-next__link" href={prev.href} rel="prev">
            <span class="prev-next__arrow" aria-hidden="true">‹</span>
            <span class="prev-next__label">上一篇</span>
            <span class="prev-next__title">{prev.title}</span>
          </a>
        ) : null}
      </div>
      <div class="prev-next__item prev-next__item--next">
        {next ? (
          <a class="prev-next__link" href={next.href} rel="next">
            <span class="prev-next__title">{next.title}</span>
            <span class="prev-next__label">下一篇</span>
            <span class="prev-next__arrow" aria-hidden="true">›</span>
          </a>
        ) : null}
      </div>
    </nav>
  ) : null}

  <Lightbox
    id="lightbox"
    label="图片预览"
    enableZoom={false}
    enablePan={false}
    enableSwipeDownClose={false}
  />

  <script>
    import '../scripts/article-toc';
    import { initArticleLightbox, initCodeCopyButtons } from '../scripts/lightbox';

    initCodeCopyButtons();
    initArticleLightbox({
      dialogId: 'lightbox',
      containerSelector: '.prose',
      enableZoom: false,
      enablePan: false,
      enableSwipeDownClose: false
    });
  </script>
</BaseLayout>
